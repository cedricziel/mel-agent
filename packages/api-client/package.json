{
  "name": "@mel-agent/api-client",
  "version": "1.0.0",
  "description": "TypeScript API client for MEL Agent, generated from OpenAPI specification",
  "author": "MEL Agent Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/cedricziel/mel-agent.git"
  },
  "keywords": [
    "api",
    "client",
    "openapi",
    "typescript",
    "mel-agent",
    "axios"
  ],
  "license": "AGPL-3.0",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "axios": "^1.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^4.0 || ^5.0"
  }
}
